# Copy this file to .env before starting the project.
# Values below are isolated local-development credentials, not production secrets.

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=mealroute
POSTGRES_USER=mealroute
POSTGRES_PASSWORD=local-kitchen-db-password-change-me
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://mealroute:local-kitchen-db-password-change-me@127.0.0.1:5432/mealroute?sslmode=disable

PLATFORM_ADDR=:8080
PLATFORM_PORT=8080
PLATFORM_HOST_PORT=8080
PLATFORM_BASE_URL=http://127.0.0.1:8080
PLATFORM_URL=http://127.0.0.1:8080
PLATFORM_HEALTHCHECK_URL=http://127.0.0.1:8080/healthz
PLATFORM_READ_HEADER_TIMEOUT=5s
PLATFORM_WRITE_TIMEOUT=15s
PLATFORM_IDLE_TIMEOUT=60s
PLATFORM_SHUTDOWN_TIMEOUT=10s

# Optional outside Compose: leave REDIS_URL empty to disable the menu cache.
# Compose uses its internal redis hostname; Redis has no published host port.
REDIS_URL=
MENU_CACHE_TTL=60s
REDIS_TIMEOUT=100ms

VENUE_ID=00000000-0000-0000-0000-000000000001
VENUE_API_KEY=local-kitchen-venue-api-key-change-me
VENUE_ADDR=:8081
VENUE_PORT=8081
VENUE_HOST_PORT=8081
VENUE_BASE_URL=http://127.0.0.1:8081
VENUE_HEALTHCHECK_URL=http://127.0.0.1:8081/v1/health
VENUE_READ_HEADER_TIMEOUT=5s
VENUE_WRITE_TIMEOUT=15s
VENUE_IDLE_TIMEOUT=60s
VENUE_SHUTDOWN_TIMEOUT=10s
VENUE_SYNC_INTERVAL=2s
VENUE_PLATFORM_HTTP_TIMEOUT=5s

TEST_DATABASE_URL=postgres://mealroute:local-kitchen-db-password-change-me@127.0.0.1:5432/mealroute?sslmode=disable
POSTGRES_INTEGRATION=1
COMPOSE_INTEGRATION=1

HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=10
